                    command "direnv"
                    args "exec" "." "cargo" "run" "-p" "sierradb-server" "--" "--config-file" "./sierra.cluster.toml" "--node-index" "0"
                }
                pane {
                    name "Node 1"
                    command "direnv"
                    args "exec" "." "cargo" "run" "-p" "sierradb-server" "--" "--config-file" "./sierra.cluster.toml" "--node-index" "1"
                }
